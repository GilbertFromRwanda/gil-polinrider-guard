# Copy this file to .env and adjust for your machine (.env is gitignored --
# it's local/machine-specific, don't commit it).
#
# Docker Compose reads .env automatically for ${VAR} substitution in
# docker-compose.yml -- no extra flag needed, just `docker compose up`.

# SCAN_PATH: mounted at /scan. Enter "/scan" in the CLI `guard` service or
# the web UI's local-path field to scan whatever this points at. Defaults
# to "." (this project directory) if unset.
# SCAN_PATH=C:/path/to/a/repo

# HOST_ROOT: mounted at /host, read-only, for the web UI's local-path
# Browse... modal (its "Host" button jumps straight there). Widens what the
# container -- and anyone who reaches the web UI -- can read, so only set
# this for a host-only, trusted deployment. Defaults to "." if unset.
#   Windows: HOST_ROOT=C:/Users/you
#   macOS:   HOST_ROOT=/Users/you
#   Linux:   HOST_ROOT=/home/you
# HOST_ROOT=C:/Users/you
