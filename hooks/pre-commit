#!/usr/bin/env bash
#
# polinrider-guard pre-commit hook.
#
# Blocks a commit if the working tree contains PolinRider-pattern findings
# (invisible Unicode, font-file masquerade, risky VS Code tasks, known IOC
# strings). This is a backstop, not a replacement for the pre-open checklist
# -- it only catches what's already in your working tree at commit time.
#
# Bypass for a single commit (e.g. known false positive):
#   POLINRIDER_GUARD_SKIP=1 git commit ...
# or the git built-in: git commit --no-verify

if [ "${POLINRIDER_GUARD_SKIP:-0}" = "1" ]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$REPO_ROOT" ] || exit 0

GUARD_CMD=()
if command -v polinrider-guard >/dev/null 2>&1; then
  GUARD_CMD=(polinrider-guard)
else
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "import polinrider_guard" >/dev/null 2>&1; then
      GUARD_CMD=("$candidate" -m polinrider_guard.guard)
      break
    fi
  done
fi

if [ "${#GUARD_CMD[@]}" -eq 0 ]; then
  echo "polinrider-guard: not installed/importable -- skipping pre-commit scan." >&2
  echo "  (install with: pip install -e /path/to/polinrider-guard)" >&2
  exit 0
fi

set +e
OUTPUT="$("${GUARD_CMD[@]}" "$REPO_ROOT" --no-git 2>&1)"
STATUS=$?
set -e

if [ "$STATUS" -ne 0 ]; then
  echo "$OUTPUT" >&2
  echo "" >&2
  echo "polinrider-guard: commit blocked -- suspicious patterns found (see above)." >&2
  echo "If this is a false positive: POLINRIDER_GUARD_SKIP=1 git commit ..." >&2
  exit 1
fi

exit 0
